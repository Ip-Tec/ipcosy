// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Custom IPCosy fields
  username      String?   @unique
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")

  // Identity Storage
  fingerprint          String? @unique
  registrationFingerprint String?
  registrationIP       String?
  registrationDeviceId String?
  lastLogin            DateTime?

  isPremium   Boolean @default(false)
  isAdmin     Boolean @default(false)
  isBanned    Boolean @default(false)
  profileViews Int     @default(0)

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]

  // App Relations
  chats         ChatParticipant[]
  messages      Message[]
  reactions     Reaction[]
  notifications Notification[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PublicInvite {
  id        String   @id @default(uuid())
  code      String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Chat {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  isGroup   Boolean  @default(false)
  name      String?  // For groups
  joinCode  String?  @unique // For joining groups
  isJoinCodePrivate Boolean @default(true) // OWNER can toggle if members see join code

  participants ChatParticipant[]
  messages     Message[]
  notifications Notification[]
}

model ChatParticipant {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())
  
  role      ParticipantRole @default(MEMBER)
  
  // Notification Settings
  isMuted              Boolean   @default(false)
  mutedUntil           DateTime?
  notificationsEnabled Boolean   @default(true)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])

  lastSeenAt DateTime @default(now())

  @@unique([userId, chatId])
}

model GlobalConfig {
  id            String @id @default("global")
  premiumPrice  Int    @default(450) // Price in Naira
  updatedAt     DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  
  content   String?  @db.Text
  fileUrl   String?
  fileType  String?  // image, video, doc
  
  // Premium User Visible (General Context)
  deviceType    String?  // "Mobile", "Desktop", "Tablet"
  deviceOS      String?  // "iOS", "Android", "Windows", "macOS", "Linux"
  browser       String?  // "Chrome", "Safari", "Firefox"
  city          String?  // "Lagos"
  country       String?  // "Nigeria"
  
  // Admin/Support Only (Security Data)
  ipAddress          String?  // Full IP address
  latitude           Float?   // GPS coordinates
  longitude          Float?   // GPS coordinates
  deviceId           String?  // Device fingerprint
  browserFingerprint String?  @db.Text // Full browser fingerprint JSON
  userAgent          String?  @db.Text // Raw user agent string
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])

  reactions     Reaction[]
  notifications Notification[]
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  
  type      String   // "NEW_MESSAGE", "NEW_CHAT", "MENTION"
  title     String
  body      String?  @db.Text
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  chatId    String?
  chat      Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
}
