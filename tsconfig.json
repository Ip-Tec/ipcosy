{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ipcosy/db": ["./packages/db/src/index.ts"],
      "@ipcosy/db/*": ["./packages/db/src/*"]
    }
  },
  "include": ["diagnose_db.ts", "packages/*/src/**/*"],
  "exclude": ["node_modules", "dist", ".next"]
}
